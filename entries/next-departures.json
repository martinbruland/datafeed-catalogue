{
  "id": "next-departures",
  "kind": "operation",
  "version": 5,
  "category": "transport",
  "region": "no",
  "plain": {
    "name": "Next departure",
    "gives": "The next departure from a Norwegian stop, including line, destination, and expected time.",
    "example": "12 to Lægdene, 21:10",
    "from": "Entur Journey Planner",
    "cadence": "Every minute; real-time data where available.",
    "asks": "An Entur stop ID."
  },
  "questions": [
    {
      "name": "stop",
      "label": "Stop ID",
      "help": "Enter an Entur stop ID, such as NSR:StopPlace:61380 for Danmarks plass in Bergen.",
      "type": "text",
      "default": "NSR:StopPlace:61380"
    }
  ],
  "attribution": "Departures from Entur (entur.org)",
  "terms": {
    "url": "https://developer.entur.org/pages-intro-authentication",
    "checked": "2026-09-04",
    "note": "Free and open; Entur asks for a client name header on every request."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "Next departure",
    "source": {
      "url": "https://api.entur.io/journey-planner/v3/graphql",
      "method": "POST",
      "parameters": [],
      "headers": [
        {
          "name": "ET-Client-Name",
          "value": {
            "literal": "martinbruland-datafeed"
          }
        },
        {
          "name": "Content-Type",
          "value": {
            "literal": "application/json"
          }
        }
      ],
      "docs": "https://developer.entur.org/pages-journeyplanner-shell",
      "body": "{\"query\":\"{ stopPlace(id: \\\"{stop}\\\") { name estimatedCalls(numberOfDepartures: 1) { expectedDepartureTime destinationDisplay { frontText } serviceJourney { line { publicCode transportMode } } } } }\"}"
    },
    "extraction": [
      {
        "name": "line",
        "path": [
          "data",
          "stopPlace",
          "estimatedCalls",
          0,
          "serviceJourney",
          "line",
          "publicCode"
        ],
        "kind": "text"
      },
      {
        "name": "to",
        "path": [
          "data",
          "stopPlace",
          "estimatedCalls",
          0,
          "destinationDisplay",
          "frontText"
        ],
        "kind": "text"
      },
      {
        "name": "leaves",
        "path": [
          "data",
          "stopPlace",
          "estimatedCalls",
          0,
          "expectedDepartureTime"
        ],
        "kind": "timestamp",
        "format": {
          "moment": {
            "relative": true
          }
        }
      },
      {
        "name": "stop",
        "path": [
          "data",
          "stopPlace",
          "name"
        ],
        "kind": "text"
      }
    ],
    "placement": {
      "size": "medium",
      "areas": {
        "title": {
          "key": "to"
        },
        "primary": {
          "key": "leaves"
        },
        "secondary": {
          "key": "line"
        },
        "picture": {
          "picture": {
            "emoji": "🚌"
          }
        }
      }
    },
    "refresh": {
      "interval": 60
    }
  }
}
