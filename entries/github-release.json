{
  "id": "github-release",
  "kind": "operation",
  "version": 4,
  "category": "code",
  "region": "global",
  "plain": {
    "name": "Latest release of a project",
    "gives": "A GitHub repository’s latest release and publication date.",
    "example": "v2.4.1, 3 days ago",
    "from": "GitHub REST API",
    "cadence": "Updated about every hour.",
    "asks": "A repository owner and name."
  },
  "questions": [
    {
      "name": "owner",
      "label": "Owner",
      "help": "Enter the GitHub account or organisation that owns the repository.",
      "type": "text",
      "default": "apple"
    },
    {
      "name": "repo",
      "label": "Project",
      "help": "Enter the repository name, such as swift.",
      "type": "text",
      "default": "swift"
    }
  ],
  "attribution": "Release data from GitHub, within its public rate limit",
  "terms": {
    "url": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service",
    "checked": "2026-09-03",
    "note": "Public data; sixty requests an hour without signing in, so the hourly interval stays."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "{owner}/{repo} release",
    "source": {
      "url": "https://api.github.com/repos/{owner}/{repo}/releases/latest",
      "method": "GET",
      "parameters": [],
      "headers": [
        {
          "name": "User-Agent",
          "value": {
            "literal": "datafeed/1.0 github.com/martinbruland/datafeed"
          }
        }
      ]
    },
    "extraction": [
      {
        "name": "version",
        "path": [
          "tag_name"
        ],
        "kind": "text"
      },
      {
        "name": "published",
        "path": [
          "published_at"
        ],
        "kind": "timestamp"
      }
    ],
    "placement": {
      "size": "medium",
      "areas": {
        "primary": {
          "key": "version"
        },
        "secondary": {
          "key": "published"
        },
        "picture": {
          "picture": {
            "illustration": "shippingbox"
          }
        }
      }
    },
    "refresh": {
      "interval": 3600
    }
  }
}
