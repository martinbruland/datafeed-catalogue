{
  "id": "city-bikes-oslo",
  "kind": "item",
  "version": 2,
  "category": "transport",
  "region": "no",
  "plain": {
    "name": "Bikes at my Oslo station",
    "gives": "How many city bikes and free docks an Oslo Bysykkel station has right now.",
    "example": "7 bikes, 5 docks",
    "from": "Oslo Bysykkel",
    "cadence": "Every few minutes, as bikes come and go.",
    "asks": "Which station, by its number."
  },
  "questions": [
    {
      "name": "station",
      "label": "Station",
      "help": "The station's number, shown in the Bysykkel app; Aker brygge is 377.",
      "type": "number",
      "default": "377"
    }
  ],
  "attribution": "Live station data from Oslo Bysykkel, licensed NLOD 2.0",
  "terms": {
    "url": "https://oslobysykkel.no/apne-data/sanntid",
    "checked": "2026-09-03",
    "note": "NLOD 2.0; every request carries a Client-Identifier header naming the app."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "Bikes at station {station}",
    "source": {
      "url": "https://gbfs.urbansharing.com/oslobysykkel.no/station_status.json",
      "method": "GET",
      "parameters": [],
      "headers": [
        {
          "name": "Client-Identifier",
          "value": {
            "literal": "martinbruland-datafeed"
          }
        }
      ]
    },
    "extraction": [
      {
        "name": "bikes",
        "path": [
          "data",
          "stations",
          {
            "where": "station_id",
            "is": "{station}"
          },
          "num_bikes_available"
        ],
        "kind": "number"
      },
      {
        "name": "docks",
        "path": [
          "data",
          "stations",
          {
            "where": "station_id",
            "is": "{station}"
          },
          "num_docks_available"
        ],
        "kind": "number"
      }
    ],
    "placement": {
      "size": "medium",
      "areas": {
        "primary": {
          "key": "bikes"
        },
        "secondary": {
          "key": "docks"
        },
        "picture": {
          "picture": {
            "emoji": "🚲"
          }
        }
      }
    },
    "refresh": {
      "interval": 300
    }
  }
}
