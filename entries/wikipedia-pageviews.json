{
  "id": "wikipedia-pageviews",
  "kind": "api",
  "version": 3,
  "category": "fun",
  "region": "global",
  "plain": {
    "name": "Wikimedia Pageviews",
    "gives": "Daily view counts for Wikipedia articles.",
    "example": "Norway: 4 512 views yesterday",
    "from": "Wikimedia Pageviews",
    "cadence": "Daily, for the previous day.",
    "asks": "Configure parameters in the builder."
  },
  "questions": [],
  "attribution": "Page views from Wikimedia",
  "terms": {
    "url": "https://wikimedia.org/api/rest_v1/",
    "checked": "2026-09-04"
  },
  "definition": {
    "schemaVersion": 1,
    "name": "Wikimedia Pageviews",
    "source": {
      "url": "https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/{project}/all-access/all-agents/{article}/daily/{start}/{end}",
      "method": "GET",
      "parameters": [
        {
          "name": "project",
          "value": "en.wikipedia"
        },
        {
          "name": "article",
          "value": "Norway"
        },
        {
          "name": "start",
          "value": "2026080100"
        },
        {
          "name": "end",
          "value": "2026080200"
        }
      ],
      "headers": [
        {
          "name": "User-Agent",
          "value": {
            "literal": "datafeed/1.0 github.com/martinbruland/datafeed"
          }
        }
      ],
      "docs": "https://wikimedia.org/api/rest_v1/#/Pageviews%20data"
    },
    "extraction": [],
    "placement": {
      "size": "medium",
      "areas": {}
    },
    "refresh": {
      "interval": 3600
    }
  }
}
