{
  "id": "sun-today",
  "kind": "operation",
  "version": 4,
  "category": "nature",
  "region": "global",
  "plain": {
    "name": "Sunrise and sunset",
    "gives": "Today’s sunrise and sunset times for your chosen location.",
    "example": "Up 06:41, down 20:32",
    "from": "Sunrise-Sunset.org",
    "cadence": "Daily.",
    "asks": "A location."
  },
  "questions": [
    {
      "name": "place",
      "label": "Place",
      "help": "Enter a place or coordinates, or use the location button if enabled.",
      "type": "location"
    }
  ],
  "attribution": "Sun times from sunrise-sunset.org",
  "terms": {
    "url": "https://sunrise-sunset.org/api",
    "checked": "2026-09-03",
    "note": "Free for reasonable volumes; attribution with a link is required."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "Sun today",
    "source": {
      "url": "https://api.sunrise-sunset.org/v2",
      "method": "GET",
      "parameters": [
        {
          "name": "lat",
          "value": "{place.lat}"
        },
        {
          "name": "lng",
          "value": "{place.lon}"
        },
        {
          "name": "date",
          "value": "{today-iso}"
        }
      ],
      "headers": []
    },
    "extraction": [
      {
        "name": "sunrise",
        "path": [
          "sunrise"
        ],
        "kind": "timestamp",
        "format": {
          "moment": {
            "relative": false
          }
        }
      },
      {
        "name": "sunset",
        "path": [
          "sunset"
        ],
        "kind": "timestamp",
        "format": {
          "moment": {
            "relative": false
          }
        }
      },
      {
        "name": "dayLength",
        "path": [
          "day_length"
        ],
        "kind": "number"
      }
    ],
    "placement": {
      "size": "medium",
      "areas": {
        "title": {
          "key": "sunrise"
        },
        "primary": {
          "key": "sunset"
        },
        "picture": {
          "picture": {
            "emoji": "🌅"
          }
        }
      }
    },
    "refresh": {
      "interval": 3600
    }
  }
}
