{
  "id": "exchange-rate",
  "kind": "operation",
  "version": 4,
  "category": "money",
  "region": "global",
  "plain": {
    "name": "Exchange rate",
    "gives": "The value of one currency in another, using daily exchange rates.",
    "example": "11.64 NOK",
    "from": "Frankfurter",
    "cadence": "Weekday afternoons.",
    "asks": "A source and target currency."
  },
  "questions": [
    {
      "name": "from",
      "label": "From",
      "help": "Choose the source currency.",
      "type": "choice",
      "choices": [
        "EUR",
        "USD",
        "GBP",
        "SEK",
        "DKK",
        "NOK",
        "CHF",
        "JPY"
      ],
      "default": "EUR"
    },
    {
      "name": "to",
      "label": "To",
      "help": "Choose the target currency.",
      "type": "choice",
      "choices": [
        "NOK",
        "EUR",
        "USD",
        "GBP",
        "SEK",
        "DKK",
        "CHF",
        "JPY"
      ],
      "default": "NOK"
    }
  ],
  "attribution": "Rates from Frankfurter and the European Central Bank",
  "terms": {
    "url": "https://frankfurter.dev/",
    "checked": "2026-09-03",
    "note": "Open source, no quotas, commercial use allowed; the ECB's data terms apply to the rates."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "{from} to {to}",
    "source": {
      "url": "https://api.frankfurter.dev/v2/rate/{from}/{to}",
      "method": "GET",
      "parameters": [],
      "headers": []
    },
    "extraction": [
      {
        "name": "rate",
        "path": [
          "rate"
        ],
        "kind": "number",
        "format": {
          "number": {
            "decimals": 2,
            "unit": "{to}"
          }
        }
      }
    ],
    "placement": {
      "size": "small",
      "areas": {
        "primary": {
          "key": "rate"
        },
        "picture": {
          "picture": {
            "emoji": "💱"
          }
        }
      }
    },
    "refresh": {
      "interval": 3600
    }
  }
}
