{
  "id": "power-price-norway",
  "kind": "operation",
  "version": 5,
  "category": "energy",
  "region": "no",
  "plain": {
    "name": "Power price now",
    "gives": "This hour’s electricity price in your Norwegian price area, in NOK per kWh.",
    "example": "1.42 kr",
    "from": "Hva koster strømmen",
    "cadence": "Hourly prices; next-day prices arrive around 13:00.",
    "asks": "A Norwegian price area."
  },
  "questions": [
    {
      "name": "area",
      "label": "Price area",
      "help": "NO1: east · NO2: south · NO3: central · NO4: north · NO5: west.",
      "type": "choice",
      "choices": [
        "NO1",
        "NO2",
        "NO3",
        "NO4",
        "NO5"
      ],
      "default": "NO5"
    }
  ],
  "attribution": "Prices from Hva koster strømmen (hvakosterstrommen.no)",
  "terms": {
    "url": "https://www.hvakosterstrommen.no/strompris-api",
    "checked": "2026-09-03",
    "note": "Free and open; the site asks to be credited with a link."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "Power price {area}",
    "source": {
      "url": "https://www.hvakosterstrommen.no/api/v1/prices/{today}_{area}.json",
      "method": "GET",
      "parameters": [],
      "headers": []
    },
    "extraction": [
      {
        "name": "now",
        "path": [
          0,
          "NOK_per_kWh"
        ],
        "kind": "number",
        "format": {
          "number": {
            "decimals": 2,
            "unit": "kr"
          }
        }
      },
      {
        "name": "from",
        "path": [
          0,
          "time_start"
        ],
        "kind": "timestamp"
      }
    ],
    "placement": {
      "size": "small",
      "areas": {
        "primary": {
          "key": "now"
        },
        "picture": {
          "picture": {
            "emoji": "⚡️"
          }
        }
      }
    },
    "refresh": {
      "interval": 3600
    }
  },
  "explains": {
    "now": "Price per kWh in NOK, before grid fees and taxes.",
    "from": "Start of the hour this price applies to."
  }
}
