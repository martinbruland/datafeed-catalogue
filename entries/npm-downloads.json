{
  "id": "npm-downloads",
  "kind": "operation",
  "version": 4,
  "category": "code",
  "region": "global",
  "plain": {
    "name": "Downloads of a package",
    "gives": "Downloads of an npm package during the past week.",
    "example": "171 637 376 downloads",
    "from": "npm Downloads",
    "cadence": "Daily.",
    "asks": "A package name."
  },
  "questions": [
    {
      "name": "package",
      "label": "Package",
      "help": "Enter the package name, such as react.",
      "type": "text",
      "default": "react"
    }
  ],
  "attribution": "Download counts from the npm registry",
  "terms": {
    "url": "https://docs.npmjs.com/policies/terms",
    "checked": "2026-09-03",
    "note": "Public registry data, free to read."
  },
  "definition": {
    "schemaVersion": 1,
    "name": "{package} downloads",
    "source": {
      "url": "https://api.npmjs.org/downloads/point/last-week/{package}",
      "method": "GET",
      "parameters": [],
      "headers": [
        {
          "name": "User-Agent",
          "value": {
            "literal": "datafeed/1.0 github.com/martinbruland/datafeed"
          }
        }
      ]
    },
    "extraction": [
      {
        "name": "downloads",
        "path": [
          "downloads"
        ],
        "kind": "number",
        "format": {
          "number": {
            "decimals": 0
          }
        }
      }
    ],
    "placement": {
      "size": "small",
      "areas": {
        "primary": {
          "key": "downloads"
        },
        "picture": {
          "picture": {
            "illustration": "arrow.down.circle"
          }
        }
      }
    },
    "refresh": {
      "interval": 21600
    }
  }
}
